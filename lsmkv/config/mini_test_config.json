{
  "data_dir": "./data",
  "memtable_max_bytes": 256,
  "max_immutable_tables": 4,
  "memtable_size_overhead_bytes_per_entry": 32,
  "rotation_cooldown_ms": 0,
  "block_size": 64,
  "bloom_false_positive": 0.01,
  "wal_fsync_every_n": 1,
  "wal_segment_roll_bytes": 1024,
  "compression": "off",
  "log_level": "info",
  "sst_dir": "./data/sst/",
  "restart_interval": 16,
  "max_build_buffer_mb": 32,
  "block_cache_mb": 64,
  "cache_index_blocks": true,
  "max_open_files": 1024,
  "manifest_path": "data/manifest.json",
  "publish_log_level": "info",
  "event_log_path": "./data/events.log",
  "size_tiered_fan_in": 2,
  "size_tiered_size_ratio": 2.0,
  "tombstone_grace_seconds": 30,
  "compaction_max_concurrent": 1,
  "compaction_io_mb_per_s": 0,
  "l0_compaction_trigger": 3,
  "l0_stop_writes": 20,
  "bg_tick_ms": 100,
  "shutdown_timeout_ms": 5000
}